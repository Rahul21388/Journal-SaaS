rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile document — read-only for the owner.
    // Writes (plan, subscriptionId, etc.) are handled exclusively by the
    // backend via Admin SDK, which bypasses these rules entirely.
    // Exception: users may update their own anchorNote field only.
    match /users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if false;
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anchorNote']);
    }

    // All subcollections (entries, digests, meta, …) — full owner access.
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
